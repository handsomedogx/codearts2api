# CodeArts service profiles discovered from CodeArts Agent 26.7.2.
# Each account stores its own environment; there is no global runtime environment switch.
CODEARTS_DEFAULT_ENVIRONMENT=cn
# Account-pool storage and automatic request routing.
CODEARTS_ACCOUNTS_DIR=data/accounts
CODEARTS_ROUTING_FILE=data/routing.json
CODEARTS_ROUTING_STRATEGY=round_robin

# China / domestic profile.
CODEARTS_CN_BASE_URL=https://snap-access.cn-north-4.myhuaweicloud.com
CODEARTS_CN_PORTAL_BASE_URL=https://codearts.huaweicloud.com
CODEARTS_CN_STS_BASE_URL=https://sts.cn-north-4.myhuaweicloud.com

# International / HK profile.
CODEARTS_INTL_BASE_URL=https://snap-access.ap-southeast-1.myhuaweicloud.com
CODEARTS_INTL_PORTAL_BASE_URL=https://codearts.ap-southeast-1.huaweicloud.com
# Official client still uses the cn-north-4 STS OAuth endpoint for this profile.
CODEARTS_INTL_STS_BASE_URL=https://sts.cn-north-4.myhuaweicloud.com

# OAuth client identity used by the official CodeArts Agent extension.
CODEARTS_AUTH_CLIENT_ID=codearts-snap
CODEARTS_AUTH_URI_SCHEME=codearts-snap
CODEARTS_AUTH_THEME=2
# Default: http://127.0.0.1:${CODEARTS2API_PORT}/oauth/callback
CODEARTS_AUTH_CALLBACK_URL=
# OAuth pending context. Only one interactive login flow is kept pending at a time.
CODEARTS_PENDING_AUTH_FILE=data/oauth_pending.json
CODEARTS_REFRESH_SKEW_SECONDS=120

# Optional manual temporary-credential fallback. OAuth login is preferred.
# Scope manual credentials to exactly one environment to avoid cross-site use.
CODEARTS_MANUAL_CREDENTIAL_ENVIRONMENT=cn
# Never commit real values.
CODEARTS_ACCESS_KEY_ID=
CODEARTS_SECRET_ACCESS_KEY=
CODEARTS_SECURITY_TOKEN=
CODEARTS_DOMAIN_ID=

# "codearts-auto" omits model_id and lets CodeArts select its normal default model.
CODEARTS_DEFAULT_MODEL=codearts-auto
CODEARTS_MODELS=codearts-auto

# Client metadata mirrored from the installed CodeArts Agent 26.7.x client.
CODEARTS_CLIENT_VERSION=26.7.2
CODEARTS_PLUGIN_NAME=codearts-snap_vscode
CODEARTS_PLUGIN_VERSION=26.7.2
CODEARTS_IDE_NAME=CodeArts Agent
CODEARTS_IDE_VERSION=26.7.1
CODEARTS_LANGUAGE=zh-cn

# Optional key protecting the local compatibility API. Leave empty only for localhost development.
CODEARTS2API_API_KEY=
CODEARTS2API_HOST=127.0.0.1
CODEARTS2API_PORT=8000
