# codearts2api normally needs no configuration.
# Start with: .\codearts2api.exe
# Then open http://127.0.0.1:8000/, add a CodeArts account,
# and copy the generated Base URL + API Key from Settings.
# Runtime data is stored under %LOCALAPPDATA%\codearts2api by default.
# Linux normally uses ~/.config/codearts2api and automatically creates a
# separate 0600 AES master key under ~/.local/state/codearts2api/master.key.

# Deployment-level overrides only.
# Use 0.0.0.0 only when you intentionally want LAN access.
CODEARTS2API_HOST=127.0.0.1
CODEARTS2API_PORT=8000

# Optional Linux secret-storage overrides (normally leave unset):
# CODEARTS2API_MASTER_KEY_FILE=/etc/codearts2api/master.key
# CODEARTS2API_MASTER_KEY=<32-byte key encoded as base64 or hex>
