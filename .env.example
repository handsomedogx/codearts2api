# codearts2api normally needs no configuration.
# Start with: uv run main.py
# Then open http://127.0.0.1:8000/, add a CodeArts account,
# and copy the generated Base URL + API Key from Settings.

# Deployment-level overrides only.
# Use 0.0.0.0 only when you intentionally want LAN access.
CODEARTS2API_HOST=127.0.0.1
CODEARTS2API_PORT=8000
